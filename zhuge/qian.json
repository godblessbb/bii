 },
 "qian": [
  {
   "n": 1,
   "text": "混沌初开，乾坤乃定，日月合璧，鸾凤和鸣。"
  },
  {
   "n": 2,
   "text": "苍蝇之飞，不过数步，附於骥尾，则腾千路。"
  },
  {
   "n": 3,
   "text": "莫言多，莫行过，虽是千伶百俐，不如一推二摩。"
  },
  {
   "n": 4,
   "text": "绝妙，绝妙，云无心以出岫，鸟倦飞而归巢，花艳艳，鱼跃跃，几般佳景，梦想不到。"
  },
  {
   "n": 5,
   "text": "绿水因风皱面，青山为雪白头，诸般皆是天造就，世上谁能强求？"
  },
  {
   "n": 6,
   "text": "不教盘算，偏要盘算，直算得三尺肠闲着二尺半，儿童拍掌笑，父老白眼看。"
  },
  {
   "n": 7,
   "text": "船到江心补漏，马临涯坎收缰，鸟入笼中跃跃，鱼在网里洋洋。"
  },
  {
   "n": 8,
   "text": "不是赏心胜景，何必踏雪寻梅，孜孜乘兴而来，怏怏俯首而回。"
  },
  {
   "n": 9,
   "text": "精细既含雪，此时糊涂少，便买卖已得，自今后经纪休夸。"
  },
  {
   "n": 10,
   "text": "莫乐莫乐，成而复破，总让尔尽心竭力，寸土不足堵黄河。"
  },
  {
   "n": 11,
   "text": "风兼影莫乱扑，究竟费功夫，慎终仍虑后，祸福不单孤。"
  },
  {
   "n": 12,
   "text": "打草惊蛇，敲山振虎，以待蛇窜虎扑，唯恐无所措手足。"
  },
  {
   "n": 13,
   "text": "物各有主，须且消停，雪里埋尸，久而自明。"
  },
  {
   "n": 14,
   "text": "狐假虎威，狗仗人势，弄到其间，尽是无益。"
  },
  {
   "n": 15,
   "text": "以蠡测海，坐井观天，虽有见识，亦是枉然。"
  },
  {
   "n": 16,
   "text": "燕巢幕上，鱼游釜中，眼前得地，脑后生风。"
  },
  {
   "n": 17,
   "text": "得陇望蜀，得鱼忘筌，天长日久，人憎狗嫌。"
  },
  {
   "n": 18,
   "text": "鼯鼠黔驴，有技有能，考其实迹，能了技净。"
  },
  {
   "n": 19,
   "text": "奇奇海市，妙妙蜃楼，一派佳景，却在浪头。"
  },
  {
   "n": 20,
   "text": "乌云遮日，黑猪渡河，郊外蒙蒙，田鸡阁阁。"
  },
  {
   "n": 21,
   "text": "雪水烹茶，桂花煮酒，一般清味，恐难到口。"
  },
  {
   "n": 22,
   "text": "虚而复实，实而却虚，木头产耳，窦里生鱼。"
  },
  {
   "n": 23,
   "text": "可叹可怜，物却有限，听之弗闻，视而不见。"
  },
  {
   "n": 24,
   "text": "栉风沐雨，戴月披星，何时可歇，直到三更。"
  },
  {
   "n": 25,
   "text": "蛙鼓惊梦，虹弓东斜，蜻蜓飞舞，蝴蝶穿花。"
  },
  {
   "n": 26,
   "text": "红日遮天，绿波盖地，渔舟稳坐，长线自持。"
  },
  {
   "n": 27,
   "text": "伐柯伐柯，顺少逆多，总有神助，亦末如何。"
  },
  {
   "n": 28,
   "text": "灯油耗尽，漏声滴彻，一听鸡鸣，逍遥自歇。"
  },
  {
   "n": 29,
   "text": "难矣哉。"
  },
  {
   "n": 30,
   "text": "山不在高，有仙则名，水不在深，有龙则灵。"
  },
  {
   "n": 31,
   "text": "万朵红云连旧府，一轮明月照前川。"
  },
  {
   "n": 32,
   "text": "白玉楼中吹玉笛，红梅阁上落梅花。"
  },
  {
   "n": 33,
   "text": "椿萱并茂，兰玉联芳。"
  },
  {
   "n": 34,
   "text": "雪来树净，月落楼空。"
  },
  {
   "n": 35,
   "text": "一木焉能支大厦。"
  },
  {
   "n": 36,
   "text": "玉燕投怀。"
  },
  {
   "n": 37,
   "text": "莫轻狂，细端详，好鸟枝头皆朋友，落花水面亦文章。"
  },
  {
   "n": 38,
   "text": "棘闹难彻。"
  },
  {
   "n": 39,
   "text": "须谨言慎行，恐孤掌难鸣。"
  },
  {
   "n": 40,
   "text": "鲋鱼只得西江水，霹雳一声到九天。"
  },
  {
   "n": 41,
   "text": "两手劈开名利路，一肩挑尽洛阳春。"
  },
  {
   "n": 42,
   "text": "莫气赌，莫气赌，虽有长鞭，不及马腹。"
  },
  {
   "n": 43,
   "text": "盲人骑瞎马，夜半临深池。"
  },
  {
   "n": 44,
   "text": "真好。"
  },
  {
   "n": 45,
   "text": "老天不害。"
  },
  {
   "n": 46,
   "text": "天覆地载，万物仰赖，鹤鸣九皋，声闻云外。"
  },
  {
   "n": 47,
   "text": "左右运转，前后拥从，夫人不言，言必有中。"
  },
  {
   "n": 48,
   "text": "水中之月，镜里之花，几般佳景，落在谁家。"
  },
  {
   "n": 49,
   "text": "海不扬波，风不鸣条，雪飞六出，半空飘。"
  },
  {
   "n": 50,
   "text": "秋风有意残杨柳，冷露无声老桂花。"
  },
  {
   "n": 51,
   "text": "梅老偏能耐雪冷，菊残却有傲霜枝。"
  },
  {
   "n": 52,
   "text": "能。"
  },
  {
   "n": 53,
   "text": "一心白雪阳春曲，两袖清风明月秋。"
  },
  {
   "n": 54,
   "text": "难。"
  },
  {
   "n": 55,
   "text": "两个黄鹂鸣翠柳，一行白鹭上青天。"
  },
  {
   "n": 56,
   "text": "春雨发生千野绿，秋风刮去一天香。"
  },
  {
   "n": 57,
   "text": "昨夜花残犹未落，今朝露湿又重开。"
  },
  {
   "n": 58,
   "text": "好。"
  },
  {
   "n": 59,
   "text": "一朵乌云惊鸟雀，半天残月映残花。"
  },
  {
   "n": 60,
   "text": "九天日月开昌运，万里风云起壮图。"
  },
  {
   "n": 61,
   "text": "方离发福生财地，又入堆金积玉门。"
  },
  {
   "n": 62,
   "text": "须放开肚皮吃饭，切站定脚根为人。"
  },
  {
   "n": 63,
   "text": "进一步门庭，添十分春色。"
  },
  {
   "n": 64,
   "text": "春风拂弱柳，细雨润新苗。"
  },
  {
   "n": 65,
   "text": "心中无险事，不怕鬼叫门。"
  },
  {
   "n": 66,
   "text": "可也。"
  },
  {
   "n": 67,
   "text": "不能。"
  },
  {
   "n": 68,
   "text": "割鸡之事，焉用牛刀。"
  },
  {
   "n": 69,
   "text": "维鹊有巢，维鸠居之。"
  },
  {
   "n": 70,
   "text": "琼浆润口，甘露滋心。"
  },
  {
   "n": 71,
   "text": "星移斗转，去旧换新。"
  },
  {
   "n": 72,
   "text": "不入虎穴，焉得虎子。"
  },
  {
   "n": 73,
   "text": "鹬蚌相持，渔翁得利。"
  },
  {
   "n": 74,
   "text": "凤毛济美，麟趾呈祥。"
  },
  {
   "n": 75,
   "text": "芝兰竞秀，玉树生香。"
  },
  {
   "n": 76,
   "text": "不危不险，去而复返。"
  },
  {
   "n": 77,
   "text": "泰阿倒持，於谁有益。"
  },
  {
   "n": 78,
   "text": "春暖鱼化，秋高鹿鸣。"
  },
  {
   "n": 79,
   "text": "旁虎吃食，有损无益。"
  },
  {
   "n": 80,
   "text": "树欲静而风不息。"
  },
  {
   "n": 81,
   "text": "蜻蜓飞舞在池塘。"
  },
  {
   "n": 82,
   "text": "伐倒大树有柴烧。"
  },
  {
   "n": 83,
   "text": "晓看明月落人家。"
  },
  {
   "n": 84,
   "text": "正遇双星渡鹊桥。"
  },
  {
   "n": 85,
   "text": "有想。"
  },
  {
   "n": 86,
   "text": "一条明路，直达青天，半途而废，可叹可怜。"
  },
  {
   "n": 87,
   "text": "执柯伐柯，则运不多，不费手脚，更无风波。"
  },
  {
   "n": 88,
   "text": "闲时赏月，忙里跑风，弄到其毕，内净外空。"
  },
  {
   "n": 89,
   "text": "仰赖天地，何必曰利，只须勤俭，胜似贸易。"
  },
  {
   "n": 90,
   "text": "浮生若梦，不用妄贪，知足常乐，能忍自安。"
  },
  {
   "n": 91,
   "text": "江水洗心，江月照肝，争南战北，不难不难。"
  },
  {
   "n": 92,
   "text": "好好好，一了百了，不啻雷惊，何殊风扫。"
  },
  {
   "n": 93,
   "text": "离而复合，成而必破，再费口舌，亦未如何。"
  },
  {
   "n": 94,
   "text": "前门拒虎，后门进狼，慎之慎之，切勿要强。"
  },
  {
   "n": 95,
   "text": "不作风波於世上，自无冰炭在胸中。"
  },
  {
   "n": 96,
   "text": "莫惆怅，莫惆怅，命里八尺，难求一丈。"
  },
  {
   "n": 97,
   "text": "闲里只夸金屋好，梦中不觉玉山颓。"
  },
  {
   "n": 98,
   "text": "猛虎斗，飞龙争，水落石出，草木皆腥。"
  },
  {
   "n": 99,
   "text": "落花流水杳然去，大块文章尽属虚。"
  },
  {
   "n": 100,
   "text": "一尊美醴倾荒野，两袖春风扫故尘。"
  },
  {
   "n": 101,
   "text": "知足方能图快乐，吃亏才是发财源。"
  },
  {
   "n": 102,
   "text": "苦雨催残桃李色，凄风吹折杨柳枝。"
  },
  {
   "n": 103,
   "text": "发财臻极宜先退，得意至浓便好休。"
  },
  {
   "n": 104,
   "text": "灯花报喜雀叫，燕子双双返故巢。"
  },
  {
   "n": 105,
   "text": "风中烛，草上霜，虽耀耀，不久长。"
  },
  {
   "n": 106,
   "text": "桃红复含宿雨，柳绿更带朝烟。"
  },
  {
   "n": 107,
   "text": "鼎折足，车脱辐，日过午，风吹烛。"
  },
  {
   "n": 108,
   "text": "小心哉，莫务外，一步错百步歪。"
  },
  {
   "n": 109,
   "text": "桃李争春色，春去桃李撇。"
  },
  {
   "n": 110,
   "text": "为山九仞，功亏一篑。"
  },
  {
   "n": 111,
   "text": "先如山倒，后如抽丝。"
  },
  {
   "n": 112,
   "text": "失之东隅，收之桑榆。"
  },
  {
   "n": 113,
   "text": "刻鹄类鹜，画虎成犬。"
  },
  {
   "n": 114,
   "text": "红梅结子，绿竹生孙。"
  },
  {
   "n": 115,
   "text": "前车之覆，后车之鉴。"
  },
  {
   "n": 116,
   "text": "获罪於天，无所祷也。"
  },
  {
   "n": 117,
   "text": "半途而废，令人落泪。"
  },
  {
   "n": 118,
   "text": "朝琢夕磨，其如命何。"
  },
  {
   "n": 119,
   "text": "命该如此，不可妄想。"
  },
  {
   "n": 120,
   "text": "精卫衔石，枉劳心机。"
  },
  {
   "n": 121,
   "text": "於心难忍，於心难安。"
  },
  {
   "n": 122,
   "text": "事不干己，何必着急。"
  },
  {
   "n": 123,
   "text": "求则得之，舍则失之。"
  },
  {
   "n": 124,
   "text": "管中窥豹，井底观天。"
  },
  {
   "n": 125,
   "text": "既知如此，何必如此。"
  },
  {
   "n": 126,
   "text": "知道莫影，却来问谁。"
  },
  {
   "n": 127,
   "text": "蝃蝀在东，莫之敢指。"
  },
  {
   "n": 128,
   "text": "拨开黑雾见青天。"
  },
  {
   "n": 129,
   "text": "丸泥可以封函关。"
  },
  {
   "n": 130,
   "text": "花开能有几时红。"
  },
  {
   "n": 131,
   "text": "同心合意步云梯。"
  },
  {
   "n": 132,
   "text": "一杆明月钓秋风。"
  },
  {
   "n": 133,
   "text": "掌上明珠粪土埋。"
  },
  {
   "n": 134,
   "text": "池上於今有凤毛。"
  },
  {
   "n": 135,
   "text": "麟趾春深步玉堂。"
  },
  {
   "n": 136,
   "text": "越鸡焉能伏鹄卵。"
  },
  {
   "n": 137,
   "text": "鸴鸠竟敢笑大鹏。"
  },
  {
   "n": 138,
   "text": "青草池塘处处蛙。"
  },
  {
   "n": 139,
   "text": "鸟兽不可与同群。"
  },
  {
   "n": 140,
   "text": "青蚨飞去复飞来。"
  },
  {
   "n": 141,
   "text": "柳暗花明别有天。"
  },
  {
   "n": 142,
   "text": "双斧伐孤树。"
  },
  {
   "n": 143,
   "text": "千辛刺腹。"
  },
  {
   "n": 144,
   "text": "百酸搅肠。"
  },
  {
   "n": 145,
   "text": "寸步难行。"
  },
  {
   "n": 146,
   "text": "痴心妄想。"
  },
  {
   "n": 147,
   "text": "船翻洋沟。"
  },
  {
   "n": 148,
   "text": "青云得步。"
  },
  {
   "n": 149,
   "text": "难。"
  },
  {
   "n": 150,
   "text": "莫轻狂，须开量，好鸟枝头皆朋友，落花水面亦文章。"
  },
  {
   "n": 151,
   "text": "人为万物灵，鬼为万物精，灵而弄精，精而弄灵。"
  },
  {
   "n": 152,
   "text": "堪愁堪忧，大被蒙头，睡而复醒，醒而云游。"
  },
  {
   "n": 153,
   "text": "穷通有命，富贵在天，南颠北跑，尽是枉然。"
  },
  {
   "n": 154,
   "text": "螟蝽蟊贼，陡生四野，恶之不尽，去之不得。"
  },
  {
   "n": 155,
   "text": "参居於西，商居於东，虽有方位，永不相见。"
  },
  {
   "n": 156,
   "text": "竹本无心，多生枝叶；藕虽有孔，不染垢尘。"
  },
  {
   "n": 157,
   "text": "囊内钱空，床头金尽，身居闹市，谁肯相近。"
  },
  {
   "n": 158,
   "text": "鸟急奔树，狗急跳墙，今逢此事，切勿转向。"
  },
  {
   "n": 159,
   "text": "能。"
  },
  {
   "n": 160,
   "text": "山崩水落，草炙花燃，人人吐火，树树冒烟。"
  },
  {
   "n": 161,
   "text": "风里烧烛，旱地拿鱼，血心虽有，名利却无。"
  },
  {
   "n": 162,
   "text": "天之生物，因材而笃，痴心妄想，天亦难顾。"
  },
  {
   "n": 163,
   "text": "莫喜莫喜，始终无底，差之毫厘，谬之千里。"
  },
  {
   "n": 164,
   "text": "不揣其本，而齐其末，虽济燃眉，恐遗后祸。"
  },
  {
   "n": 165,
   "text": "夸父遂日，杞人忧天，心小气大，名利茫然。"
  },
  {
   "n": 166,
   "text": "刻舟求剑，剖腹藏珠，血心耿耿，名利虚虚。"
  },
  {
   "n": 167,
   "text": "为人谋，何所图，成了赚坏骨，败而落匹夫。"
  },
  {
   "n": 168,
   "text": "冰生於水而寒於水，青出於蓝而深於蓝。"
  },
  {
   "n": 169,
   "text": "可奈何，可奈何，中流见砥柱，平地起风波。"
  },
  {
   "n": 170,
   "text": "淄渑之滋味，宜办泾渭之清浊，当分以待分辨不均，惟恐乱乱纷纷。"
  },
  {
   "n": 171,
   "text": "莫强求，一薰一莸，十年尚犹有臭。"
  },
  {
   "n": 172,
   "text": "与效城狐社鼠，宁为陶犬瓦鸡。"
  },
  {
   "n": 173,
   "text": "走韩卢而搏蹇兔。"
  },
  {
   "n": 174,
   "text": "蜉蝣今夜落残花。"
  },
  {
   "n": 175,
   "text": "鸡肋不足安尊拳。"
  },
  {
   "n": 176,
   "text": "狗尾续貂。"
  },
  {
   "n": 177,
   "text": "砍竹遮笋。"
  },
  {
   "n": 178,
   "text": "罢罢罢。"
  },
  {
   "n": 179,
   "text": "有想。"
  },
  {
   "n": 180,
   "text": "莫望。"
  },
  {
   "n": 181,
   "text": "既知重轻，何用叮咛，可止则止，可行则行。"
  },
  {
   "n": 182,
   "text": "以卵撞石。"
  },
  {
   "n": 183,
   "text": "海底捞月。"
  },
  {
   "n": 184,
   "text": "景星入户。"
  },
  {
   "n": 185,
   "text": "群蚁附膻。"
  },
  {
   "n": 186,
   "text": "李生道旁。"
  },
  {
   "n": 187,
   "text": "花发上林。"
  },
  {
   "n": 188,
   "text": "不敢说好。"
  },
  {
   "n": 189,
   "text": "河清海晏。"
  },
  {
   "n": 190,
   "text": "天下太平。"
  },
  {
   "n": 191,
   "text": "绝无所好。"
  },
  {
   "n": 192,
   "text": "发物蒙尘。"
  },
  {
   "n": 193,
   "text": "振枝败叶。"
  },
  {
   "n": 194,
   "text": "一木撑天。"
  },
  {
   "n": 195,
   "text": "破麦剖梨。"
  },
  {
   "n": 196,
   "text": "势若催枯。"
  },
  {
   "n": 197,
   "text": "推枯拉朽。"
  },
  {
   "n": 198,
   "text": "大器晚成。"
  },
  {
   "n": 199,
   "text": "器满必倾。"
  },
  {
   "n": 200,
   "text": "萋斐成锦。"
  },
  {
   "n": 201,
   "text": "城火殃池鱼。"
  },
  {
   "n": 202,
   "text": "可厌可怜，花落庭间。"
  },
  {
   "n": 203,
   "text": "有醴难酌，有膳难用，有气难堵，有话难言。"
  },
  {
   "n": 204,
   "text": "人即是鬼，鬼即是人，人会弄鬼，鬼会弄人。"
  },
  {
   "n": 205,
   "text": "明知莫想，却来问我。"
  },
  {
   "n": 206,
   "text": "既知是好，何必来占。"
  },
  {
   "n": 207,
   "text": "得意不可再往。"
  },
  {
   "n": 208,
   "text": "好事不如无。"
  },
  {
   "n": 209,
   "text": "事不由己。"
  },
  {
   "n": 210,
   "text": "谁说有成。"
  },
  {
   "n": 211,
   "text": "无可无不可。"
  },
  {
   "n": 212,
   "text": "自惹其祸。"
  },
  {
   "n": 213,
   "text": "不必。"
  },
  {
   "n": 214,
   "text": "好。"
  },
  {
   "n": 215,
   "text": "虽言富贵在天，穷通有命，亦须行尽人事，以听天命。"
  }
 ]
}